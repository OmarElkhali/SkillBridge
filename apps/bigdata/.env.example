COMPOSE_PROJECT_NAME=skillbridge_bigdata

# Local PostgreSQL mirror used by Sqoop and Python Big Data scripts.
BIGDATA_DB_HOST=localhost
BIGDATA_DB_PORT=5433
BIGDATA_DB_NAME=skillbridge
BIGDATA_DB_USER=skillbridge
BIGDATA_DB_PASSWORD=skillbridge

# Dataset ZIP files. Your friend must edit these paths to match their machine.
SKILLBRIDGE_DATASET_FINAL_ZIP=C:\Users\YOUR_NAME\Downloads\archive (1).zip
SKILLBRIDGE_DATASET_ALL_COURSES_ZIP=C:\Users\YOUR_NAME\Downloads\archive.zip
SKILLBRIDGE_DATASET_RICH_ZIP=C:\Users\YOUR_NAME\Downloads\archive (2).zip

HDFS_BASE=/data/skillbridge
HIVE_DATABASE=skillbridge_bigdata

